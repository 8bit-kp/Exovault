# Exovault environment variables. No real secrets belong in this file.
# Run `npm run env:init` to create .env.local with freshly generated secrets.
# Every variable is validated at startup by config/env.ts.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (local MongoDB Community Server; always include the db name) ---
MONGODB_URI=mongodb://127.0.0.1:27017/exovault
# Tests must never touch the dev database; name must end in _test.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/exovault_test

# --- Redis (BullMQ from M2; must use maxmemory-policy noeviction) ---
REDIS_URL=redis://127.0.0.1:6379
# Where scans run: inline (inside the web process; dev / single server) or bullmq (separate worker: npm run worker).
SCAN_QUEUE=inline
WORKER_CONCURRENCY=4
MONITORING_TICK_MS=60000
NOTIFICATION_DISPATCH_MS=60000

# --- Exposure providers ---
# mock = deterministic demo providers, no API keys. live = real providers.
PROVIDER_MODE=mock
# Required only when PROVIDER_MODE=live. Get one at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Requests per minute of your HIBP subscription (Core 1 = 10). The scan engine stays under it.
HIBP_REQUESTS_PER_MINUTE=10

# --- Identifier protection (spec Part 5.1) ---
# Keyring for AES-256-GCM field encryption: keyId:base64(32 bytes), comma-separated for rotation.
IDENTIFIER_ENCRYPTION_KEYS=v1:REPLACE_WITH_32_BYTES_BASE64
IDENTIFIER_ENCRYPTION_ACTIVE_KEY_ID=v1
# HMAC-SHA-256 pepper for blind indexes: base64(32 bytes). Separate from the encryption keys.
BLIND_INDEX_PEPPER=REPLACE_WITH_32_BYTES_BASE64

# --- Auth ---
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
# Check new passwords against Pwned Passwords (k-anonymity range API): on | off
PASSWORD_BREACH_CHECK=on
# Reverse proxies in front of the app (0 when the browser connects to Next.js directly).
TRUSTED_PROXY_COUNT=0

# --- Email (Mailpit in dev: UI at http://localhost:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Only for authenticated SMTP (production transactional provider).
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Exovault <no-reply@exovault.example>

# --- Product limits ---
MAX_ACTIVE_IDENTITIES_PER_USER=1
